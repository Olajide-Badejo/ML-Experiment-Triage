# This repository is developed on Windows and tested on Ubuntu in CI.
# Text is normalised to LF in the object store so a CRLF Makefile or shell
# script never reaches the Linux runner.
* text=auto eol=lf

Makefile text eol=lf
*.py text eol=lf
*.sh text eol=lf
*.tex text eol=lf
*.bib text eol=lf
*.yml text eol=lf
*.md text eol=lf

# Binary fixtures and artifacts must never be line ending converted.
*.pdf binary
*.png binary
*.db binary
*.npy binary
*.tfevents.* binary
# The event file only, not the whole directory. `config.json` sits beside it
# and is ordinary text: marking it binary froze the CRLF that the Windows
# generator had written into the object store, where no Linux or macOS run of
# the generator could ever reproduce it.
tests/fixtures/tensorboard/**/events.out.tfevents.* binary
