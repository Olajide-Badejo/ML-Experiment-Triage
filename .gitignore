# Environment
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# Hypothesis keeps the inputs that failed here so it can replay them first. It
# is a per machine cache of counterexamples, not a result: what a failing
# property proved belongs in a test or in the changelog, not in this database.
.hypothesis/

# Build and packaging output. `python -m build` writes both, and a wheel left
# in the tree is the kind of thing that gets committed once and then installed
# by somebody a year later.
build/
dist/
*.whl

# Coverage output.
.coverage
.coverage.*
htmlcov/
coverage.xml

# Per machine tool settings, which are a local preference rather than a project
# decision and differ between contributors.
.claude/settings.local.json

# Generated demo run directories and any ad hoc database.
# The demo sweep is deterministic, so the raw logs are rebuilt rather than stored.
experiments/results/
triage.db
triage.db-journal

# The demo database is the exception and is tracked on purpose: the LaTeX
# reports and the CI report job compile from it without regenerating the sweep,
# and `make verify-demo` proves it still matches what the seeds produce.
!experiments/demo/triage.db

# Generated report assets and LaTeX build directories.
report/figures/
report/tables/
report/build/
report_debug/build/
*.aux
*.log
*.out
*.toc
*.lof
*.lot
*.bbl
*.blg
*.fls
*.fdb_latexmk
*.synctex.gz

# Local working material. One pattern rather than a list of file names: an
# ignore rule is published with the repository, so naming the private files
# tells every reader what they are called and that they exist.
/private/
